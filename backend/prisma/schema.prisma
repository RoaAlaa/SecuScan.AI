generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  scans     Scan[]
}

model Scan {
  id                      String   @id @default(uuid())
  targetUrl               String
  status                  String   @default("pending")
  reportUrl               String?
  callbackToken           String?  @unique
  crawlMode               Int?
  crawlOutput             String?  @db.Text
  selectedVulnerabilities Json?
  createdAt               DateTime @default(now())
  finishedAt              DateTime?
  userId                  String?
  user                    User?    @relation(fields: [userId], references: [id])
  reports                 Report[]
  workflowRuns            WorkflowRun[]
  documentChunks          DocumentChunk[]
}

model WorkflowRun {
  id            String    @id @default(uuid())
  scanId        String
  vulnerability String
  status        String    @default("pending")
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, vulnerability])
  @@index([scanId])
}

model Report {
  id        String   @id @default(uuid())
  scanId    String
  type      String
  severity  String
  details   Json
  createdAt DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id])

  documentChunks DocumentChunk[]
}

model ReportAccess {
  id        String   @id @default(uuid())
  scanId    String
  email     String
  token     String   @unique
  expiresAt DateTime
}



model DocumentChunk {
  id         String   @id @default(uuid())
  content    String   @db.Text
  embedding  Unsupported("vector")?
  sourceType String   // "knowledge" or "report" - NEEDED for access control
  reportId   String?
  scanId     String?
  metadata   Json?
  createdAt  DateTime @default(now())
  
  // Optional: relations for type safety
  report     Report?  @relation(fields: [reportId], references: [id])
  scan       Scan?    @relation(fields: [scanId], references: [id])

  @@index([sourceType])
  @@index([scanId])
  @@index([reportId])
  @@index([createdAt])
}