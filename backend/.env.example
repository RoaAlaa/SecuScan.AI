# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/vulnscanner"

# Auth
JWT_SECRET="your-secret-key-change-in-production"

# URLs (used for report links, email links, etc.)
FRONTEND_URL="http://localhost:3100"
BACKEND_URL="http://localhost:5001"

# Multi-workflow n8n integration
CRAWLER_WEBHOOK_URL="http://localhost:5678/webhook/8ce2ddde-b5ad-41a2-be34-833d5939a25d"
SQLI_WEBHOOK_URL="http://localhost:5678/webhook/a620df0a-2ef6-44f8-a534-ea4a110f9953"
SSTI_WEBHOOK_URL="http://localhost:5678/webhook/ac219317-3050-4f68-96d7-a5eb891c67e2"
SSRF_WEBHOOK_URL="http://localhost:5678/webhook/8aa920b3-0996-4364-8e9d-58b2a85a756d"
BAC_WEBHOOK_URL="http://localhost:5678/webhook/859da481-d229-4337-a804-dc7adc7d4204"
LFI_WEBHOOK_URL="http://localhost:5678/webhook/af6520ee-b091-48aa-a81a-fdea673f2fd8"

# Optional workflow timeouts (milliseconds)
CRAWLER_TIMEOUT_MS="300000"
WORKFLOW_TIMEOUT_MS="600000"

# Email (SMTP) – scan-complete notifications
# Works with Gmail, SendGrid, Mailgun, AWS SES, Resend SMTP, etc.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Secu Scan <noreply@yourdomain.com>"

# RAG / AI (optional)
OLLAMA_URL="http://localhost:11434"
EMBEDDING_MODEL="nomic-embed-text"
CHAT_MODEL="llama3.2"
