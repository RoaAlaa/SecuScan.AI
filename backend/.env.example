# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/vulnscanner"

# Auth
JWT_SECRET="your-secret-key-change-in-production"

# URLs (used for report links, email links, etc.)
FRONTEND_URL="http://localhost:3100"
BACKEND_URL="http://localhost:5000"

# Multi-workflow n8n integration
CRAWLER_WEBHOOK_URL="http://localhost:5678/webhook/crawler"
SQLI_WEBHOOK_URL="http://localhost:5678/webhook/sqli"
SSTI_WEBHOOK_URL="http://localhost:5678/webhook/ssti"
SSRF_WEBHOOK_URL="http://localhost:5678/webhook/ssrf"
BAC_WEBHOOK_URL="http://localhost:5678/webhook/bac"
LFI_WEBHOOK_URL="http://localhost:5678/webhook/path-traversal"

# Optional workflow timeouts (milliseconds)
CRAWLER_TIMEOUT_MS="300000"
WORKFLOW_TIMEOUT_MS="600000"

# Email (SMTP) – scan-complete notifications
# Works with Gmail, SendGrid, Mailgun, AWS SES, Resend SMTP, etc.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Secu Scan <noreply@yourdomain.com>"

# RAG / AI (optional)
OLLAMA_URL="http://localhost:11434"
EMBEDDING_MODEL="nomic-embed-text"
CHAT_MODEL="llama3.2"
