# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/vulnscanner"

# Auth
JWT_SECRET="your-secret-key-change-in-production"

# URLs (used for report links, n8n callback, etc.)
FRONTEND_URL="http://localhost:3100"
BACKEND_URL="http://localhost:5000"

# n8n integration – webhook URL to trigger scan workflow
# Get this from your n8n Webhook node (Production URL)
# If not set, scans are created but no external workflow is triggered
N8N_WEBHOOK_URL="http://localhost:5678/webhook-test/your-webhook-id"

# Email (SMTP) – scan-complete notifications
# Works with Gmail, SendGrid, Mailgun, AWS SES, Resend SMTP, etc.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Secu Scan <noreply@yourdomain.com>"

# RAG / AI (optional)
OLLAMA_URL="http://localhost:11434"
EMBEDDING_MODEL="nomic-embed-text"
CHAT_MODEL="llama3.2"
